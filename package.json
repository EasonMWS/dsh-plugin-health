{
  "name": "dsh-plugin-health",
  "version": "0.1.1",
  "description": "Multi-host compatibility matrix, official format-1 market index builder, Windows/WSL install doctor, and in-DSH plugin health tool for DeepSeek Harness (dsh) plugins.",
  "type": "module",
  "main": "./src/plugin.js",
  "bin": {
    "dsh-plugin-health": "bin/dsh-plugin-health.js",
    "dsh-health": "bin/dsh-plugin-health.js"
  },
  "exports": {
    ".": "./src/plugin.js",
    "./api": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "author": "EasonMWS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EasonMWS/dsh-plugin-health.git"
  },
  "homepage": "https://github.com/EasonMWS/dsh-plugin-health#readme",
  "bugs": {
    "url": "https://github.com/EasonMWS/dsh-plugin-health/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "plugin-market",
    "format-1",
    "compatibility",
    "semver",
    "windows",
    "wsl"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "matrix": "node bin/dsh-plugin-health.js matrix",
    "index": "node bin/dsh-plugin-health.js index",
    "doctor": "node bin/dsh-plugin-health.js doctor"
  },
  "dependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "^0.2.1-alpha.4",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  }
}
