{
  "name": "dsh-plugin-health",
  "version": "1.0.1",
  "description": "The DSH plugin checker that can actually repair what it finds. Scans every installed plugin, rehearses each rejected one in a throwaway home to prove it boots, and only then writes a reversible exemption — or tells you honestly that it cannot be saved. Also recovers DSH when a plugin stops it booting, prepares AI briefs, and builds the official format-1 market index.",
  "type": "module",
  "main": "./src/plugin.js",
  "bin": {
    "dsh-plugin-health": "bin/dsh-plugin-health.js",
    "dsh-health": "bin/dsh-plugin-health.js"
  },
  "exports": {
    ".": "./src/plugin.js",
    "./api": "./src/index.js",
    "./client": "./src/ui/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "docs/images",
    "docs/upgrade-0.2.1.md",
    "docs/upgrade-0.2.1-rc3.md",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": ">=0.1.0-rc.6 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "author": "EasonMWS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EasonMWS/dsh-plugin-health.git"
  },
  "homepage": "https://easonmws.github.io/dsh-plugin-health/",
  "bugs": {
    "url": "https://github.com/EasonMWS/dsh-plugin-health/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "plugin-manager",
    "plugin-management",
    "plugin-doctor",
    "plugin-health",
    "plugin-check",
    "plugin-checker",
    "plugin-inspector",
    "plugin-scan",
    "plugin-conflict",
    "conflict-detection",
    "conflict-checker",
    "incompatible-plugins",
    "dependency-check",
    "diagnostics",
    "troubleshooting",
    "doctor",
    "repair",
    "fix-plugins",
    "broken-plugin",
    "plugin-market",
    "format-1",
    "compatibility",
    "compatibility-matrix",
    "upgrade-check",
    "version-check",
    "github-action",
    "semver",
    "windows",
    "wsl",
    "插件管理",
    "插件检查",
    "插件冲突",
    "插件诊断",
    "插件不兼容"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "test:runtime": "node scripts/runtime-acceptance.js",
    "matrix": "node bin/dsh-plugin-health.js matrix",
    "index": "node bin/dsh-plugin-health.js index",
    "doctor": "node bin/dsh-plugin-health.js doctor"
  },
  "dependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "^0.2.1-alpha.4",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  }
}
